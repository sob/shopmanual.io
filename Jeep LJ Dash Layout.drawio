edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1554.00" y="630.00" as="sourcePoint"/><mxPoint x="1554.00" y="708.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="Overall 239 mm (9.41 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.00" y="690.00" as="sourcePoint"/><mxPoint x="1554.00" y="690.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="Order left to right: driver seat heat | rear + front lockers | winch IN/OUT | drive mode | passenger seat heat. ARB: keep locker switches in the driver&#x27;s reach and line of sight, at least 50 mm (2 in) clear behind the cutout, and put ARB warning sticker 210101 next to them. Seat and MODE singles in green LED to match the blue-off / green-on duals." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60.00" y="738.00" width="1560.00" height="120.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dash-2" name="Console - front plate"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="GenRight standard-width center console - front plate (to scale, 1 mm = 3 px)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.00" y="24.00" width="990.00" height="30.00" as="geometry"/></mxCell><mxCell id="c4" value="Width is GenRight&#x27;s published 8-1/4 in (the narrow console is 6 in, shown dashed). Plate height is not published: the 150 mm draw