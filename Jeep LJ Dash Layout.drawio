 as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="narrow console (6 in) edges" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="513.60" y="1216.00" width="220.00" height="16.00" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.45" y="280.00" as="sourcePoint"/><mxPoint x="450.45" y="266.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="869.55" y="280.00" as="sourcePoint"/><mxPoint x="869.55" y="266.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="209.5 mm (8.25 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.45" y="260.00" as="sourcePoint"/><mxPoint x="869.55" y="260.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;dashed=1;dashPattern=12 4 2 4;strokeColor=#7f7f7f;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.00" y="308.00" as="sourcePoint"/><mxPoint x="660.00" y="1260.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="DRIVER SEAT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;fontSize=13;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="270.45" y="580.00" width="140.00" height="20.00" as="geometry"/></mxCell><mxCell id="c21" value="PASSENGER SEAT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="909.55" y="580.00" width="180.00" height="20.00" as="geometry"/></mxCell><mxCell id="c22" value="Kilduff KIL8HP70 shifter body 4.5 x 10 in (114 x 254 mm), 5 in tall; tallest handle 11 in" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545.70" y="360.00" width="228.60" height="508.00" as="geometry"/></mxCell><mxCell id="c23" value="SwitchPros RCR-Force 12 panel 4.0 x 3.0 in (102 x 76 mm), reads from the seats. Bezel cutout 3.875 x 2.875 in, 0.237 in corners, or surface mount on 6-32 studs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#000000;fontColor=#ffffff;fontSize=11;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="558.40" y="918.00" width="203.20" height="152.40" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.70" y="360.00" as="sourcePoint"/><mxPoint x="424.45" y="360.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.70" y="868.00" as="sourcePoint"/><mxPoint x="424.45" y="868.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="254 mm (10 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="418.45" y="360.00" as="sourcePoint"/><mxPoint x="418.45" y="868.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558.40" y="868.00" as="sourcePoint"/><mxPoint x="424.45" y="868.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558.40" y="918.00" as="sourcePoint"/><mxPoint x="424.45" y="918.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="418.45" y="868.00" as="sourcePoint"/><mxPoint x="418.45" y="918.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="25 mm gap (proposed)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;align=right;" vertex="1" parent="1"><mxGeometry x="294.45" y="884.00" width="116.00" height="16.00" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558.40" y="918.00" as="sourcePoint"/><mxPoint x="424.45" y="918.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558.40" y="1070.40" as="sourcePoint"/><mxPoint x="424.45" y="1070.40" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="76 mm (3 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="418.45" y="918.00" as="sourcePoint"/><mxPoint x="418.45" y="1070.40" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.45" y="360.00" as="sourcePoint"/><mxPoint x="284.45" y="360.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.45" y="1070.40" as="sourcePoint"/><mxPoint x="284.45" y="1070.40" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="355 mm (13.98 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="278.45" y="360.00" as="sourcePoint"/><mxPoint x="278.45" y="1070.40" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.70" y="360.00" as="sourcePoint"/><mxPoint x="545.70" y="350.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="774.30" y="360.00" as="sourcePoint"/><mxPoint x="774.30" y="350.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="114 mm (4.5 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.70" y="344.00" as="sourcePoint"/><mxPoint x="774.30" y="344.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="Checks from this drawing: the shifter body and the panel need 355 mm (14.0 in) of top-plate length with a 25 mm gap, plus whatever sits in front of the shifter. Both fit inside the narrow console&#x27;s 6 in as well as the standard 8-1/4 in. Before cutting: check that a hand on the panel clears the lever at its rearmost position, and where the NP241OR transfer-case lever comes through. GenRight says this console is not designed to work with the factory transfer-case shifter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="909.55" y="660.00" width="360.00" height="300.00" as="geometry"/></mxCell><mxCell id="c41" value="The SwitchPros comm cable now runs from the power module on the firewall to the console. SwitchPros sells it in 5 ft steps from 5 to 50 ft, plus 6 in for strain relief: measure the route before ordering." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="909.55" y="980.00" width="360.00" height="120.00" as="geometry"/></mxCell><mxCell id="c42" value="Sources: Kilduff KIL8HP70 body 10 x 4.5 x 5 in, tallest handle 11 in (Kilduff product page); SwitchPros RCR-Force 12 panel 4.0 x 3.0 x 0.375 in, bezel cutout 3.875 x 2.875 in r0.237, 6-32 studs (RCR-Force 12 guide Rev 1.9 pp.9, 14); comm cable 5-50 ft (SwitchPros store); GenRight DSH-2000 console 8-1/4 in wide, narrow 6 in, not designed for the factory t-case shifter (GenRight). Dashed red = not published / not measured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40.00" y="1288.00" width="1120.00" height="60.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
