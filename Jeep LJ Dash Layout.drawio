" height="85.72" as="geometry"/></mxCell><mxCell id="c17" value="USB-C / USB-A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="555.79" y="344.14" width="85.72" height="85.72" as="geometry"/></mxCell><mxCell id="c18" value="Powerwerx PanelUSB-75W x2: 1-1/8 in (28.6 mm) holes, placed to fit either console width" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="210.00" y="441.00" width="448.65" height="36.00" as="geometry"/></mxCell><mxCell id="c19" value="Restomod Air control head - size unknown (placeholder)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;fontColor=#b85450;fontSize=11;verticalAlign=middle;align=center;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="269.32" y="501.00" width="330.00" height="180.00" as="geometry"/></mxCell><mxCell id="c20" value="Proposed use of the front plate: two USB chargers at the top corners, the Restomod Air control head below. The air gauge could come here instead of the passenger dash. The Kilduff shifter and the SwitchPros panel are on the top plate (next page)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="778.65" y="285.00" width="450.00" height="180.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dash-3" name="Console - top plate"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Center console top plate - plan view (to scale, 1 mm = 2 px)" style="text;html=