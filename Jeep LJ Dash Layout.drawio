</mxCell><mxCell id="c32" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1519.00" y="872.36" as="sourcePoint"/><mxPoint x="1519.00" y="910.36" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="Switch row 239 mm (9.41 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1041.00" y="904.36" as="sourcePoint"/><mxPoint x="1519.00" y="904.36" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1485.74" y="300.00" as="sourcePoint"/><mxPoint x="1573.00" y="300.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1485.74" y="872.36" as="sourcePoint"/><mxPoint x="1573.00" y="872.36" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="Stack 286 mm (11.27 in)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1567.00" y="300.00" as="sourcePoint"/><mxPoint x="1567.00" y="872.36" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="0-200 psi" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1707.61" y="367.61" width="104.77" height="104.77" as="geometry"/></mxCell><mxCell id="c38" value="Air pressure gauge (not selected - standard 2-1/16 in / 52 mm shown)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1830.00" y="390.00" width="160.00" height="80.00" as="geometry"/></mxCell><mxCell id="c39" value="Checks from this drawing: the stack needs 286 mm (11.3 in) of height from the Garmin top to the switch row bottom, and the row needs 239 mm (9.4 in) of width. The Garmin face (206 x 170 mm) is larger than an iPad mini (195 x 135 mm), which is what GenRight says its center opening fits, so the Garmin sits over the opening on its cradle." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580.00" y="660.00" width="400.00" height="160.00" as="geometry"/></mxCell><mxCell id="c40" value="Sources: Garmin Tread 2 8.1 x 6.7 in (Garmin spec); Fusion MS-RA670 face 157 x 68 mm, 102 mm behind panel (Fusion Apollo MS-RA670 Owner&#x27;s Manual p.37); CH4X4 switch face 39 x 21 mm (CH4X4 product pages); Rugged STX-RS remote head fits a standard rocker hole (Rugged), 0.830 x 1.45 in (Carling); DGD start button 22 mm hole, face 3 mm larger (Digital Guard Dawg); Powerwerx PanelUSB-75W 1-1/8 in hole (Powerwerx); GenRight console 8-1/4 in wide, narrow 6 in (GenRight). Dashed red = not published / not measured - replace with measurements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=0;fontFamily=Helvetica;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="80.00" y="1100.00" width="2120.00" height="80.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dash-1" name="Switch row - detail"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Dash switch row - CH4X4 Toyot